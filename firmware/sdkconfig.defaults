# Base configuration for the Caipo devkit (target-independent).
# ESP32-S3-specific overrides live in sdkconfig.defaults.esp32s3.
# The generated sdkconfig is gitignored - persistent settings go here.

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Bluetooth: NimBLE host, peripheral only (companion app contract, ble_link)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Bonds survive reboot (R01.3 "persist pairing")
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=8
# LE Secure Connections only; legacy pairing off
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
# 509-byte R03 chunks need the full MTU
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
# Buffer pool sized for back-to-back 509-byte notifications
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
